# Required database connections (DIRECT_URL should bypass pooling)
DATABASE_URL="postgresql://user:password@host:5432/campusbrain?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/campusbrain?sslmode=require"

# Replace with different random secrets before deployment (at least 32 chars each)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Required storage configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# External paper-chat integration; built-in AI Coach uses the API directly
BOT_BASE_URL="https://your-paper-chat.example.com"

# Optional AI keys. No keys => generated quizzes/flashcards return 503.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
HUGGINGFACE_API_KEY=""

# Gemini embeddings win when its key is set; otherwise Hugging Face is used.
# Changing providers requires re-indexing ALL vectors; there is no cross-provider fallback.
# Topic-profile alias expansion uses Gemini.

PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
# Explicit trusted preview/development origins, comma separated, no paths.
CORS_ORIGINS=""

# Optional production seed credentials; existing passwords are never overwritten.
# SEED_ADMIN_PASSWORD=""
# SEED_TEACHER_PASSWORD=""
# Access to study tools and profiles: admin or signed-in.
STUDY_FEATURE_ACCESS=admin
