# ── Database ──────────────────────────────────────────────────────────────────
# Use a hosted Postgres provider (Neon, Supabase, Railway, etc.)
# e.g. postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct URL needed by Prisma for migrations (same as above without pgbouncer params)
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Streamlit AI App ──────────────────────────────────────────────────────────
BOT_BASE_URL="https://your-streamlit-app.streamlit.app"

# ── AI: LLM (100% free) ───────────────────────────────────────────────────────
# Get a free Groq key at https://console.groq.com (no credit card needed)
# Used for MCQ generation, flashcards, study plan, timetable parsing, syllabus parsing
GROQ_API_KEY=""

# ── AI: Embeddings / RAG (100% free — pick at least one) ─────────────────────
# Option A — Gemini text-embedding-004 (768 dims, recommended, generous quota)
#   Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Option B — Hugging Face Inference API, model: BAAI/bge-base-en-v1.5 (768 dims)
#   Get free key at: https://huggingface.co/settings/tokens  (read token is enough)
#   Used as fallback if GEMINI_API_KEY fails or is not set
HUGGINGFACE_API_KEY=""

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
