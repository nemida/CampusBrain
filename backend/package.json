{
  "name": "campusbrain-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CampusBrain API — Express + Prisma + Cloudinary",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/google-genai": "^2.3.5",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.7.2",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/client": "6.7.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.15.3",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.6.1",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "express-validator": "7.2.1",
    "groq-sdk": "^1.6.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.2",
    "openai": "^4.100.0",
    "pdf-parse": "^2.4.5",
    "prisma": "6.7.0",
    "typescript": "5.8.3",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "eslint": "9.25.1",
    "tsx": "4.19.3"
  }
}
