generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  role             Role              @default(STUDENT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  flashcardSets    FlashcardSet[]
  groupMemberships GroupMembership[]
  mcqSessions      MCQSession[]
  refreshTokens    RefreshToken[]
  resources        Resource[]        @relation("UploadedBy")
  ownedGroups      StudyGroup[]      @relation("GroupOwner")
  studyPlans       StudyPlan[]
  userActivities   UserActivity[]
  profile          UserProfile?
  textbookMaterials TextbookMaterial[]
  unitNotes         UnitNote[]
}

model UserProfile {
  id        String               @id @default(cuid())
  userId    String               @unique
  year      Int?
  branchId  String?
  semester  Int?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  branch    Branch?              @relation(fields: [branchId], references: [id])
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  UserProfileSubject[]
}

model UserProfileSubject {
  id        String      @id @default(cuid())
  profileId String
  subjectId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([profileId, subjectId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id        String        @id @default(cuid())
  name      String        @unique
  code      String        @unique
  createdAt DateTime      @default(now())
  subjects  Subject[]
  syllabi   Syllabus[]
  profiles  UserProfile[]
}

model Subject {
  id              String               @id @default(cuid())
  code            String
  name            String
  semester        Int
  branchId        String
  resources       Resource[]
  studyPlanDays   StudyPlanDay[]
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  syllabusItems   SyllabusItem[]
  profileSubjects UserProfileSubject[]

  @@unique([code, branchId])
  @@index([branchId, semester])
}

model Resource {
  id             String          @id @default(cuid())
  subjectId      String
  uploadedById   String
  type           ResourceType    @default(PAPER)
  title          String
  year           Int
  examType       ExamType
  fileUrl        String
  publicId       String
  fileSizeBytes  Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  paperQuestions PaperQuestion[]
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation("UploadedBy", fields: [uploadedById], references: [id])
  chunks         ResourceChunk[]
  userActivities UserActivity[]

  @@index([subjectId])
  @@index([year])
}

/// One text chunk extracted from a PYQ PDF, with its embedding vector.
model ResourceChunk {
  id         String                 @id @default(cuid())
  resourceId String
  subjectId  String
  chunkIndex Int
  pageNumber Int?
  text       String
  /// pgvector column — 768 dims for Gemini text-embedding-004
  /// (Prisma raw SQL handles reads/writes; this column is managed via migration SQL)
  createdAt  DateTime               @default(now())
  embedding  Unsupported("vector")?
  resource   Resource               @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([subjectId])
}

/// One text chunk from a SyllabusItem (unit title + topics), with its embedding vector.
model SyllabusChunk {
  id             String                 @id @default(cuid())
  syllabusItemId String
  subjectId      String?
  text           String
  /// pgvector column — 768 dims (managed via migration SQL)
  createdAt      DateTime               @default(now())
  embedding      Unsupported("vector")?
  syllabusItem   SyllabusItem           @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)

  @@index([syllabusItemId])
  @@index([subjectId])
}

model Syllabus {
  id          String         @id @default(cuid())
  branchId    String
  semester    Int
  scheme      String         @default("2021")
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items       SyllabusItem[]

  @@unique([branchId, semester, scheme])
  @@index([branchId, semester])
}

model SyllabusItem {
  id         String          @id @default(cuid())
  syllabusId String
  subjectId  String?
  unitNumber Int
  title      String
  topics     String[]
  hours      Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  chunks     SyllabusChunk[]
  subject    Subject?        @relation(fields: [subjectId], references: [id])
  syllabus   Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  textbookMaterials TextbookMaterial[]
  notes             UnitNote[]

  @@index([syllabusId])
}

enum MaterialStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
}

/// Reading material is separate from exam resources so it cannot enter the PYQ index.
model TextbookMaterial {
  id                  String         @id @default(cuid())
  unitId              String
  uploadedById        String
  title               String
  fileUrl             String
  publicId            String
  fileSizeBytes       Int
  status              MaterialStatus @default(PENDING)
  pageCount           Int            @default(0)
  processedPages      Int            @default(0)
  unreadablePages     Int[]          @default([])
  error               String?
  processingStartedAt DateTime?
  processingRunId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  unit                SyllabusItem   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  uploadedBy          User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks              TextbookChunk[]

  @@index([unitId, status])
  @@index([status, createdAt])
}

model TextbookChunk {
  id         String                 @id @default(cuid())
  materialId String
  pageNumber Int
  chunkIndex Int
  text       String
  source     String                 @default("text")
  embedding  Unsupported("vector")?
  model      String?
  material   TextbookMaterial       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
}

model UnitNote {
  id        String       @id @default(cuid())
  userId    String
  unitId    String
  title     String
  content   Json
  inputs    Json
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      SyllabusItem @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([userId, unitId, createdAt])
}

model StudyPlan {
  id        String         @id @default(cuid())
  userId    String
  title     String
  examDate  DateTime?
  totalDays Int
  status    PlanStatus     @default(ACTIVE)
  groupId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  config    Json?
  group     StudyGroup?    @relation(fields: [groupId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      StudyPlanDay[]

  @@index([userId])
  @@index([groupId])
}

model StudyPlanDay {
  id          String    @id @default(cuid())
  studyPlanId String
  dayNumber   Int
  date        DateTime?
  subjectId   String?
  topics      String[]
  isCompleted Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Json?
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject     Subject?  @relation(fields: [subjectId], references: [id])

  @@index([studyPlanId])
}

model StudyGroup {
  id          String            @id @default(cuid())
  name        String
  description String?
  inviteCode  String            @unique @default(cuid())
  ownerId     String
  branch      String?
  semester    Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
  owner       User              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  studyPlans  StudyPlan[]

  @@index([ownerId])
}

model GroupMembership {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole  @default(MEMBER)
  joinedAt DateTime   @default(now())
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model UserActivity {
  id           String       @id @default(cuid())
  userId       String
  resourceId   String?
  activityType ActivityType
  metadata     Json?
  createdAt    DateTime     @default(now())
  resource     Resource?    @relation(fields: [resourceId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
  @@index([userId, activityType])
}

model MCQSession {
  id         String        @id @default(cuid())
  userId     String
  subjectId  String?
  topic      String?
  totalQ     Int
  correctQ   Int           @default(0)
  score      Float         @default(0)
  timeTakenS Int?
  createdAt  DateTime      @default(now())
  questions  MCQQuestion[]
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MCQQuestion {
  id           String     @id @default(cuid())
  sessionId    String
  question     String
  options      String[]
  correctIndex Int
  chosenIndex  Int?
  explanation  String?
  topic        String?
  createdAt    DateTime   @default(now())
  session      MCQSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model FlashcardSet {
  id        String      @id @default(cuid())
  userId    String
  title     String
  subjectId String?
  topic     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cards     Flashcard[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Flashcard {
  id          String       @id @default(cuid())
  setId       String
  front       String
  back        String
  easeFactor  Float        @default(2.5)
  interval    Int          @default(1)
  repetitions Int          @default(0)
  nextReview  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  set         FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([nextReview])
}

model PaperQuestion {
  id            String                 @id @default(cuid())
  resourceId    String
  subjectId     String
  questionIndex Int
  label         String?
  marks         Int?
  text          String
  embedding     Unsupported("vector")?
  createdAt     DateTime               @default(now())
  pageNumber    Int?
  source        String                 @default("text")
  resource      Resource               @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([subjectId])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ExamType {
  MID_SEM
  END_SEM
}

enum ResourceType {
  PAPER
  NOTES
  SYLLABUS
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum GroupRole {
  OWNER
  MEMBER
}

enum ActivityType {
  VIEW
  DOWNLOAD
  QUIZ_ATTEMPT
  PLAN_DAY_COMPLETE
}

model TopicProfile {
  id          String   @id @default(cuid())
  key         String   @unique // lowercase "context|topic"
  topic       String
  description String
  aliases     String[]
  embedding   Json?    // number[768]; Json avoids raw SQL for a few hundred rows
  model       String?  // embedding model used, so you can invalidate on a model change
  createdAt   DateTime @default(now())
}
